diff --git a/refqd/export_eval.py b/refqd/export_eval.py
new file mode 100644
index 0000000..1b647ae
--- /dev/null
+++ b/refqd/export_eval.py
@@ -0,0 +1,406 @@
+'''Re-evaluate the archive of a RefQD Atari run (task.bd=ours) with the common protocol.
+
+Every filled cell becomes a policy (shared representation + its decision head). Each policy
+plays --num-episodes full games (one per env, distinct seeds) with a 27k-step cap; the score is
+the raw game score and the descriptor is the mean of the per-step RAM descriptors over the
+whole game, clipped to [-1, 1]. Writes <run-dir>/evaluation_results.json.
+
+    python -m refqd.export_eval --run-dir runs/<run>
+'''
+
+import jax
+import jax.numpy as jnp
+import qdax.core.emitters.multi_emitter
+from qdax.core.containers.mapelites_repertoire import MapElitesRepertoire
+
+import numpy as np
+import envpool
+from omegaconf import OmegaConf
+
+import argparse
+import json
+import os
+import pickle
+import time
+
+from .containers import ExtendedDepthRepertoire
+from .emitters import RefEmitterState
+from .metrics import qd_metrics
+from .neuroevolution import CNN, activation
+from .tasks import AtariTask
+from .tasks.atari_descriptors import ATARI_DESCRIPTORS
+from .utils import xz_read
+
+
+VENDI_BANDWIDTH = 0.5
+
+
+def vendi_score(descriptors: np.ndarray, sigma: float = 0.5) -> float:
+    n = descriptors.shape[0]
+    if n <= 1:
+        return float(n)
+    diff = descriptors[:, None, :] - descriptors[None, :, :]
+    kmat = np.exp(-(diff ** 2).sum(axis=-1) / (2.0 * sigma * sigma))
+    kmat = 0.5 * (kmat + kmat.T) / n
+    eigvals = np.clip(np.linalg.eigvalsh(kmat), 1e-12, None)
+    eigvals = eigvals / eigvals.sum()
+    return float(np.exp(-(eigvals * np.log(eigvals)).sum()))
+
+
+def summarize_population_results(
+    per_policy_returns: list[list[float]],
+    per_policy_descs: list[list[np.ndarray]],
+    per_policy_lengths: list[list[int]],
+    desc_names: list[str],
+    num_episodes: int,
+    n: int,
+    k: int,
+) -> dict:
+    results = {
+        'num_rollouts_per_policy': num_episodes,
+        'descriptor_names': desc_names,
+        'N': n,
+        'K': k,
+        'policies': [],
+    }
+    all_returns = []
+    all_descs = []
+
+    def _std(values: np.ndarray) -> float:
+        return float(values.std(ddof=1)) if len(values) > 1 else 0.0
+
+    def _sem(values: np.ndarray) -> float:
+        return _std(values) / float(np.sqrt(len(values))) if len(values) > 0 else 0.0
+
+    for i in range(n):
+        rets = np.array(per_policy_returns[i][:num_episodes], dtype=np.float64)
+        descs = np.stack(per_policy_descs[i][:num_episodes])
+        lens = np.array(per_policy_lengths[i][:num_episodes])
+        all_returns.append(rets)
+        all_descs.append(descs.mean(axis=0))
+
+        rollouts = [{
+            'rollout_idx': idx,
+            'return': float(rets[idx]),
+            'length': int(lens[idx]),
+            'behavior_descriptor': descs[idx].astype(float).tolist(),
+        } for idx in range(num_episodes)]
+
+        policy_result = {
+            'policy_idx': i,
+            'return_mean': float(rets.mean()),
+            'return_std': _std(rets),
+            'return_sem': _sem(rets),
+            'return_min': float(rets.min()),
+            'return_max': float(rets.max()),
+            'length_mean': float(lens.mean()),
+            'behavior_descriptor_mean': descs.mean(axis=0).astype(float).tolist(),
+            'behavior_descriptor_std': descs.std(axis=0, ddof=1).astype(float).tolist()
+            if len(descs) > 1
+            else np.zeros(k, dtype=float).tolist(),
+            'rollouts': rollouts,
+        }
+        for k_idx, dname in enumerate(desc_names):
+            policy_result[f'desc_{dname}_mean'] = float(descs[:, k_idx].mean())
+            policy_result[f'desc_{dname}_std'] = (
+                float(descs[:, k_idx].std(ddof=1)) if len(descs) > 1 else 0.0
+            )
+        results['policies'].append(policy_result)
+
+    all_rets_flat = np.concatenate(all_returns)
+    pop_descs = np.stack(all_descs)
+    policy_return_means = np.array([r.mean() for r in all_returns], dtype=np.float64)
+    best_idx = int(np.argmax(policy_return_means))
+    best_returns = all_returns[best_idx]
+
+    if n > 1:
+        dists = np.linalg.norm(pop_descs[:, None, :] - pop_descs[None, :, :], axis=-1)
+        avg_pairwise_distance = float(dists[np.triu_indices(n, k=1)].mean())
+    else:
+        avg_pairwise_distance = 0.0
+
+    results['population'] = {
+        'best_policy_idx': best_idx,
+        'best_policy_return_mean': float(best_returns.mean()),
+        'best_policy_return_std': _std(best_returns),
+        'best_policy_return_sem': _sem(best_returns),
+        'return_mean': float(all_rets_flat.mean()),
+        'return_std': _std(all_rets_flat),
+        'return_mean_all_rollouts': float(all_rets_flat.mean()),
+        'return_std_all_rollouts': _std(all_rets_flat),
+        'return_sem_all_rollouts': _sem(all_rets_flat),
+        'mean_policy_return_mean': float(policy_return_means.mean()),
+        'std_policy_return_mean': _std(policy_return_means),
+        'per_policy_return_means': [float(r.mean()) for r in all_returns],
+        'descriptor_means': pop_descs.astype(float).tolist(),
+        'avg_pairwise_behavior_distance': avg_pairwise_distance,
+        'vendi_score': vendi_score(pop_descs.astype(np.float32), sigma=VENDI_BANDWIDTH),
+        'vendi_bandwidth': VENDI_BANDWIDTH,
+    }
+    if n > 1:
+        results['population']['descriptor_spread'] = float(pop_descs.std(axis=0).mean())
+
+    return results
+
+
+def archive_metrics(fitnesses: jax.Array, qd_offset: float) -> dict[str, float]:
+    metrics = qd_metrics(MapElitesRepertoire(None, fitnesses, None, None), qd_offset)
+    return {key: float(value) for key, value in metrics.items()}
+
+
+def load_run(run_dir: str):
+    cfg = OmegaConf.load(os.path.join(run_dir, 'cfg.yaml'))
+    assert cfg.multiseed is None
+    assert cfg.task.bd == 'ours'
+    saved = pickle.loads(xz_read(os.path.join(run_dir, cfg.compressed_checkpoint_filename)))
+    state = saved['state']
+
+    emitter_state = state.emitter_state
+    while isinstance(emitter_state, qdax.core.emitters.multi_emitter.MultiEmitterState):
+        emitter_state = emitter_state.emitter_states[0]
+    assert isinstance(emitter_state, RefEmitterState)
+    if emitter_state.emitted_representation_params is not None:
+        representation_params = emitter_state.emitted_representation_params
+    else:
+        representation_params = emitter_state.representation_params
+
+    repertoire = state.repertoire
+    if isinstance(repertoire, ExtendedDepthRepertoire):
+        global_genotypes = saved['$extended_depth_repertoire.global_genotypes']
+    else:
+        global_genotypes = saved['$extended_me_repertoire.global_genotypes']
+    handle = int(np.asarray(repertoire.genotypes).flatten()[0])
+    cells = np.flatnonzero(np.isfinite(np.asarray(repertoire.fitnesses)))
+    heads = jax.tree_map(lambda x: np.asarray(x)[cells], global_genotypes[handle])
+    return cfg, representation_params, heads, cells, repertoire
+
+
+def build_nets(cfg, task: AtariTask) -> tuple[CNN, CNN]:
+    net_cfg = cfg.network
+    assert net_cfg.emitter_type == 'Share'
+    representation_net = CNN(
+        conv_features=net_cfg.representation_conv_features,
+        conv_kernel_sizes=net_cfg.representation_conv_kernel_sizes,
+        conv_activation=activation(net_cfg.conv_activation),
+        conv_strides=net_cfg.representation_conv_strides,
+        conv_padding=net_cfg.conv_padding,
+        mlp_layer_sizes=net_cfg.representation_mlp_hidden_layer_sizes,
+        mlp_activation=activation(net_cfg.mlp_activation),
+        mlp_final_activation=activation(net_cfg.mlp_final_activation),
+        cnn_input_shape=task.obs_space.shape,
+    )
+    decision_net = CNN(
+        conv_features=net_cfg.conv_features,
+        conv_kernel_sizes=net_cfg.conv_kernel_sizes,
+        conv_activation=activation(net_cfg.conv_activation),
+        conv_strides=net_cfg.conv_strides,
+        conv_padding=net_cfg.conv_padding,
+        mlp_layer_sizes=(*net_cfg.mlp_hidden_layer_sizes, int(task.action_space.n)),
+        mlp_activation=activation(net_cfg.mlp_activation),
+        mlp_final_activation=activation(net_cfg.mlp_final_activation),
+        cnn_input_shape=net_cfg.decision_cnn_input_shape,
+    )
+    return representation_net, decision_net
+
+
+def play_games(
+    env_name: str,
+    select_action_fn,
+    representation_params,
+    heads,
+    descriptor_fn,
+    num_episodes: int,
+    seed: int,
+    sticky: float,
+    max_episode_steps: int,
+    k: int,
+    max_rest: int = 256,
+):
+    """Play the first full game of every env; env i uses env seed seed + i.
+
+    Once at most max_rest games are unfinished, only those are replayed from reset in a small pool (same env seeds)
+    instead of stepping every env until the longest game ends. The policy input keeps the full chunk shape, so the
+    replayed games take the same actions. At the step where the first pass stopped, the replayed games must match it
+    (emulator RAM, returns and descriptor sums); on any difference the chunk is played again without the replay.
+    """
+    n_cells = jax.tree_util.tree_leaves(heads)[0].shape[0]
+    n_envs = n_cells * num_episodes
+    env_seeds = np.arange(seed, seed + n_envs)
+    returns = np.zeros(n_envs)
+    lengths = np.zeros(n_envs, dtype=np.int64)
+    desc_sums = np.zeros((n_envs, k))
+    finished = np.zeros(n_envs, dtype=bool)
+    full_obs = None
+    ids = np.arange(n_envs)
+    for phase in (1, 2):
+        env = envpool.make_gymnasium(
+            env_name,
+            num_envs=len(ids),
+            seed=int(env_seeds[ids[0]]),
+            env_seed=env_seeds[ids].tolist(),
+            img_height=84,
+            img_width=84,
+            stack_num=1,
+            episodic_life=True,
+            repeat_action_probability=sticky,
+            max_episode_steps=max_episode_steps,
+        )
+        obs, info = env.reset()
+        prev_ram = info['ram']
+        returns[ids] = 0
+        lengths[ids] = 0
+        desc_sums[ids] = 0
+        done = np.zeros(len(ids), dtype=bool)
+        step = 0
+        while not done.all():
+            x = np.moveaxis(np.divide(obs, np.float32(255.0), dtype=np.float32), -3, -1).reshape(len(ids), -1)
+            if full_obs is None:
+                full_obs = x
+            else:
+                full_obs[ids] = x
+            action = np.asarray(
+                select_action_fn(representation_params, heads, full_obs.reshape(n_cells, num_episodes, -1))
+            ).reshape(-1)[ids]
+            obs, _, _, trunc, info = env.step(action)
+            game_over = info['terminated'].astype(bool) | trunc
+            desc = descriptor_fn(info['ram'], prev_ram, action)
+            prev_ram = info['ram']
+            active = ~done
+            returns[ids[active]] += info['reward'][active]
+            lengths[ids[active]] += 1
+            desc_sums[ids[active]] += desc[active]
+            done |= game_over
+            step += 1
+            if phase == 1 and n_envs > 2 * max_rest and 0 < (~done).sum() <= max_rest:
+                break
+            if phase == 2 and step == stop_step:
+                replay_ok = (
+                    not done.any()
+                    and np.array_equal(prev_ram, stop_ram)
+                    and np.array_equal(returns[ids], stop_returns)
+                    and np.array_equal(desc_sums[ids], stop_desc_sums)
+                )
+                if not replay_ok:
+                    break
+        del env
+        if phase == 2 and not replay_ok:
+            print('replay differs from the first pass, playing the chunk without replay', flush=True)
+            return play_games(
+                env_name, select_action_fn, representation_params, heads, descriptor_fn, num_episodes, seed,
+                sticky, max_episode_steps, k, max_rest=0,
+            )
+        finished[ids] = done
+        if finished.all():
+            break
+        ids = np.flatnonzero(~finished)
+        stop_step, stop_ram = step, prev_ram[~done].copy()
+        stop_returns, stop_desc_sums = returns[ids].copy(), desc_sums[ids].copy()
+        replay_ok = False
+    descs = np.clip(desc_sums / lengths[:, None], -1.0, 1.0).astype(np.float32)
+    shape = (n_cells, num_episodes)
+    return returns.reshape(shape), descs.reshape(*shape, k), lengths.reshape(shape)
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser(description=__doc__.split('\n')[0])
+    ap.add_argument('--run-dir', required=True)
+    ap.add_argument('--num-episodes', type=int, default=32)
+    ap.add_argument('--cells-per-chunk', type=int, default=64)
+    ap.add_argument('--seed', type=int, default=None, help='defaults to run seed + 1000')
+    ap.add_argument('--repeat-action-probability', type=float, default=0.0)
+    ap.add_argument('--max-episode-steps', type=int, default=27000)
+    args = ap.parse_args()
+
+    cfg, representation_params, heads, cells, repertoire = load_run(args.run_dir)
+    task = AtariTask(cfg.task, (1,))
+    representation_net, decision_net = build_nets(cfg, task)
+    desc_names, descriptor_fn = ATARI_DESCRIPTORS[cfg.task.descriptor_set]
+    k = len(desc_names)
+    seed = args.seed if args.seed is not None else int(cfg.seed[0]) + 1000
+
+    @jax.jit
+    def select_action_fn(representation_params, heads, obs):
+        representation = representation_net.apply(representation_params, obs)
+        q = jax.vmap(decision_net.apply)(heads, representation)
+        return jnp.argmax(q, axis=-1)
+
+    returns, descs, lengths = [], [], []
+    n_chunks = -(-len(cells) // args.cells_per_chunk)
+    for chunk in range(n_chunks):
+        start = chunk * args.cells_per_chunk
+        stop = min(start + args.cells_per_chunk, len(cells))
+        t = time.monotonic()
+        r, d, n = play_games(
+            task.env_name,
+            select_action_fn,
+            representation_params,
+            jax.tree_map(lambda x: x[start:stop], heads),
+            descriptor_fn,
+            args.num_episodes,
+            seed + start * args.num_episodes,
+            args.repeat_action_probability,
+            args.max_episode_steps,
+            k,
+        )
+        returns.extend(r)
+        descs.extend(d)
+        lengths.extend(n)
+        print(
+            f'chunk {chunk + 1}/{n_chunks}: cells {start}-{stop - 1}, '
+            f'mean score {r.mean():.1f}, mean length {n.mean():.0f}, {time.monotonic() - t:.0f}s',
+            flush=True,
+        )
+
+    n = len(cells)
+    results = summarize_population_results(
+        [list(r) for r in returns],
+        [list(d) for d in descs],
+        [list(x) for x in lengths],
+        list(desc_names),
+        args.num_episodes,
+        n,
+        k,
+    )
+    train_fitnesses = np.asarray(repertoire.fitnesses)
+    train_descriptors = np.asarray(repertoire.descriptors)
+    for policy, cell in zip(results['policies'], cells):
+        policy['cell_idx'] = int(cell)
+        policy['train_fitness'] = float(train_fitnesses[cell])
+        policy['train_descriptor'] = train_descriptors[cell].astype(float).tolist()
+
+    fitnesses = jnp.asarray(results['population']['per_policy_return_means'], dtype=jnp.float32)
+    eval_repertoire = MapElitesRepertoire.init(
+        genotypes=jnp.arange(n, dtype=jnp.float32),
+        fitnesses=fitnesses,
+        descriptors=jnp.asarray(results['population']['descriptor_means'], dtype=jnp.float32),
+        centroids=jnp.asarray(repertoire.centroids),
+    )
+    results['archive'] = {
+        'n_centroids': int(repertoire.centroids.shape[0]),
+        'qd_offset': task.qd_offset,
+        'eval': archive_metrics(eval_repertoire.fitnesses, task.qd_offset),
+        'train': archive_metrics(jnp.asarray(train_fitnesses), task.qd_offset),
+    }
+
+    results['run_dir'] = args.run_dir
+    results['env_id'] = task.env_name
+    results['descriptor_set'] = cfg.task.descriptor_set
+    results['seed'] = seed
+    results['envs_per_policy'] = args.num_episodes
+    results['repeat_action_probability'] = args.repeat_action_probability
+
+    output_file = os.path.join(args.run_dir, 'evaluation_results.json')
+    with open(output_file, 'w') as f:
+        json.dump(results, f, indent=2)
+    pop = results['population']
+    print(
+        f'best policy {pop["best_policy_idx"]}: {pop["best_policy_return_mean"]:.1f}, '
+        f'mean {pop["mean_policy_return_mean"]:.1f}, vendi {pop["vendi_score"]:.3f}\n'
+        f'archive eval {results["archive"]["eval"]}\n'
+        f'archive train {results["archive"]["train"]}\n'
+        f'saved -> {output_file}'
+    )
+
+
+if __name__ == '__main__':
+    main()
